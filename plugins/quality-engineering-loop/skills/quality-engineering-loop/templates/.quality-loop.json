{
  "version": "1.0",
  "description": "Quality Engineering Loop CI 配置",
  "gates": {
    "coverage_rate": {
      "threshold": 0.80,
      "level": "error",
      "message": "PRD 规则覆盖率低于 80%，请补充测试或修复代码偏差"
    },
    "test_alignment_rate": {
      "threshold": 0.90,
      "level": "warning",
      "message": "测试对齐率低于 90%，建议补充测试用例"
    },
    "code_gap_count": {
      "threshold": 0,
      "level": "error",
      "message": "存在 CODE_GAP: 代码未实现 PRD 规则"
    },
    "mismatch_count": {
      "threshold": 0,
      "level": "error",
      "message": "存在实现偏差: 代码与 PRD 不一致"
    }
  },
  "triggers": {
    "prd_change": {
      "paths": ["docs/working/prd/**/*.md"],
      "actions": ["analyze", "matrix"],
      "gate": false,
      "description": "PRD 变更时触发分析（不阻塞合并）"
    },
    "code_change": {
      "paths": ["src/**/*.ts", "src/**/*.js", "src/**/*.vue"],
      "actions": ["matrix", "review"],
      "gate": true,
      "description": "代码变更时检查覆盖矩阵（阻塞合并）"
    },
    "test_change": {
      "paths": ["test/**/*.test.ts", "test/**/*.spec.ts"],
      "actions": ["matrix"],
      "gate": true,
      "description": "测试变更时更新矩阵（阻塞合并）"
    }
  },
  "artifacts": {
    "output_dir": ".quality-reports",
    "files": [
      "prd-analysis.json",
      "coverage-matrix.json",
      "review-checklist.json",
      "summary.md"
    ],
    "retention_days": 30
  },
  "notifications": {
    "pr_comment": {
      "enabled": true,
      "template": "default",
      "include_matrix": true,
      "include_action_items": true
    },
    "slack": {
      "enabled": false,
      "webhook_url": "",
      "on_gate_failure": true
    }
  },
  "dev_standards_backfill": {
    "enabled": true,
    "threshold_repeated_issues": 3,
    "output_path": "docs/dev-standards/backfill.md"
  }
}
