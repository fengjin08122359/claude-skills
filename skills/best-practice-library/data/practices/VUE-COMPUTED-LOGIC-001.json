{
  "id": "VUE-COMPUTED-LOGIC-001",
  "name": "Vue复杂逻辑使用Computed",
  "summary": "在 Vue 组件中，涉及条件判断或数据转换的复杂逻辑应封装在 computed 计算属性中。",
  "description": "避免在模板中进行复杂的逻辑运算或方法调用。computed 属性具有缓存机制，只在依赖变化时重新计算，提高性能和可读性。",
  "category": "component-design",
  "techStack": {
    "vueVersion": ">=2.7.0",
    "typescriptVersion": ">=4.5.0"
  },
  "scenarios": [
    {
      "description": "模板中的复杂表达式",
      "useCases": [
        "条件渲染逻辑（多个条件组合）",
        "数据格式化和转换",
        "列表过滤和排序",
        "状态派生计算"
      ],
      "notApplicableWhen": [
        "简单的属性访问",
        "单次使用的简单表达式"
      ]
    }
  ],
  "implementation": {
    "principles": [
      "模板保持简洁，只包含简单表达式",
      "复杂逻辑提取到 computed",
      "利用 computed 的缓存特性",
      "为 computed 提供明确的类型注解"
    ],
    "steps": [
      {
        "step": 1,
        "action": "识别模板中的复杂逻辑",
        "codeExample": "<!-- ❌ 不推荐 -->\n<template>\n  <div v-if=\"user && user.profile && user.profile.isActive && user.profile.role === 'admin'\">\n    {{ user.firstName + ' ' + user.lastName }}\n  </div>\n</template>",
        "notes": "模板中包含多层嵌套条件和字符串拼接"
      },
      {
        "step": 2,
        "action": "提取为 computed 属性",
        "codeExample": "<script setup lang=\"ts\">\nimport { computed } from 'vue';\n\nconst isAdmin = computed(() => \n  user.value?.profile?.isActive && user.value?.profile?.role === 'admin'\n);\n\nconst fullName = computed(() => \n  `${user.value?.firstName ?? ''} ${user.value?.lastName ?? ''}`.trim()\n);\n</script>\n\n<template>\n  <div v-if=\"isAdmin\">\n    {{ fullName }}\n  </div>\n</template>",
        "notes": "每个 computed 只做一件事，命名清晰表达意图"
      },
      {
        "step": 3,
        "action": "添加类型注解",
        "codeExample": "const isAdmin = computed<boolean>(() => {\n  if (!user.value?.profile) return false;\n  return user.value.profile.isActive && user.value.profile.role === 'admin';\n});\n\nconst fullName = computed<string>(() => {\n  const first = user.value?.firstName ?? '';\n  const last = user.value?.lastName ?? '';\n  return `${first} ${last}`.trim();\n});",
        "notes": "明确的返回类型有助于类型检查和文档化"
      }
    ],
    "requirements": [
      {
        "requirement": "模板中的条件表达式超过 2 个操作符时必须使用 computed",
        "mandatory": true,
        "verificationMethod": "code-review"
      },
      {
        "requirement": "所有 computed 必须有明确的类型注解",
        "mandatory": true,
        "verificationMethod": "lint-rule",
        "relatedRule": "@typescript-eslint/explicit-function-return-type"
      },
      {
        "requirement": "computed 名称应清晰表达其含义",
        "mandatory": true,
        "verificationMethod": "code-review"
      }
    ],
    "examples": {
      "standard": {
        "description": "用户权限检查",
        "code": "<script setup lang=\"ts\">\nimport { computed } from 'vue';\nimport type { User } from '@/types/user';\n\ninterface Props {\n  user: User | null;\n}\n\nconst props = defineProps<Props>();\n\n// 复杂权限逻辑提取为 computed\nconst canEdit = computed<boolean>(() => {\n  if (!props.user) return false;\n  return props.user.role === 'admin' || \n         (props.user.role === 'editor' && props.user.isActive);\n});\n\nconst displayName = computed<string>(() => {\n  if (!props.user) return '未知用户';\n  return `${props.user.firstName} ${props.user.lastName}`.trim() || props.user.email;\n});\n</script>\n\n<template>\n  <div class=\"user-info\">\n    <h3>{{ displayName }}</h3>\n    <button v-if=\"canEdit\" @click=\"editUser\">编辑</button>\n  </div>\n</template>",
        "filePath": "src/components/UserInfo.vue"
      },
      "variants": [
        {
          "name": "列表过滤变体",
          "description": "对列表进行动态过滤和排序",
          "code": "<script setup lang=\"ts\">\nimport { ref, computed } from 'vue';\n\nconst users = ref<User[]>([]);\nconst searchKeyword = ref('');\nconst sortBy = ref<'name' | 'date'>('name');\n\n// 过滤和排序逻辑\nconst filteredUsers = computed<User[]>(() => {\n  let result = users.value.filter(user => \n    user.name.toLowerCase().includes(searchKeyword.value.toLowerCase())\n  );\n  \n  result.sort((a, b) => {\n    if (sortBy.value === 'name') {\n      return a.name.localeCompare(b.name);\n    }\n    return new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime();\n  });\n  \n  return result;\n});\n</script>\n\n<template>\n  <div>\n    <input v-model=\"searchKeyword\" placeholder=\"搜索用户\" />\n    <select v-model=\"sortBy\">\n      <option value=\"name\">按名称</option>\n      <option value=\"date\">按日期</option>\n    </select>\n    <ul>\n      <li v-for=\"user in filteredUsers\" :key=\"user.id\">\n        {{ user.name }}\n      </li>\n    </ul>\n  </div>\n</template>",
          "whenToUse": "需要实时过滤和排序的列表场景"
        }
      ]
    }
  },
  "tradeoffs": {
    "benefits": [
      "性能优化：computed 有缓存机制",
      "可读性提升：模板更简洁",
      "可测试性：computed 可以单独测试",
      "类型安全：更容易添加类型注解"
    ],
    "drawbacks": [
      "增加代码量",
      "需要为每个逻辑命名",
      "过度使用可能导致过多的 computed"
    ],
    "comparisons": [
      {
        "alternativePattern": "模板内联表达式",
        "whenToChooseThis": "逻辑复杂度中等以上、需要复用、需要缓存",
        "whenToChooseAlternative": "非常简单的表达式（如单个属性访问）"
      },
      {
        "alternativePattern": "Methods",
        "whenToChooseThis": "基于响应式数据的计算、需要缓存",
        "whenToChooseAlternative": "需要传参、不需要缓存的场景"
      }
    ]
  },
  "performance": {
    "metrics": [
      {
        "metric": "重复渲染次数",
        "baseline": "每次渲染都执行（methods）",
        "optimized": "仅依赖变化时执行（computed）",
        "measurementMethod": "Vue Devtools Performance 面板"
      }
    ],
    "optimizationTips": [
      "避免在 computed 中执行副作用",
      "不要修改响应式数据",
      "对于昂贵的计算，考虑使用 memoization"
    ]
  },
