{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "prd-quality-report.schema.json",
  "title": "PRD 质量评估报告",
  "description": "prd-quality-improver skill 的输出，6维质量评分 + 改进建议 + 版本趋势",
  "type": "object",
  "required": ["report_id", "prd_file", "scores", "suggestions"],
  "properties": {
    "report_id": { "type": "string" },
    "prd_file": { "type": "string" },
    "test_files": { "type": "array", "items": { "type": "string" } },
    "generated_at": { "type": "string", "format": "date-time" },
    "scores": { "$ref": "#/definitions/Scores" },
    "suggestions": {
      "type": "array",
      "items": { "$ref": "#/definitions/Suggestion" }
    },
    "version_trend": {
      "type": "object",
      "description": "版本演进趋势，key 为版本号",
      "additionalProperties": { "$ref": "#/definitions/VersionScore" }
    }
  },
  "definitions": {
    "Scores": {
      "type": "object",
      "required": ["completeness", "clarity", "boundary_coverage", "exception_coverage", "consistency", "testability", "overall"],
      "properties": {
        "completeness": { "type": "integer", "minimum": 0, "maximum": 100 },
        "clarity": { "type": "integer", "minimum": 0, "maximum": 100 },
        "boundary_coverage": { "type": "integer", "minimum": 0, "maximum": 100 },
        "exception_coverage": { "type": "integer", "minimum": 0, "maximum": 100 },
        "consistency": { "type": "integer", "minimum": 0, "maximum": 100 },
        "testability": { "type": "integer", "minimum": 0, "maximum": 100 },
        "overall": { "type": "integer", "minimum": 0, "maximum": 100 }
      }
    },
    "Suggestion": {
      "type": "object",
      "required": ["id", "priority", "category", "title"],
      "properties": {
        "id": { "type": "string" },
        "priority": { "type": "string", "enum": ["P0", "P1", "P2"] },
        "category": {
          "type": "string",
          "enum": ["completeness", "clarity", "boundary", "exception", "consistency", "testability", "terminology"]
        },
        "title": { "type": "string" },
        "source_test": { "type": "string", "description": "发现此建议的测试用例ID" },
        "prd_location": { "type": ["string", "null"], "description": "PRD 中的位置，null 表示 PRD 中无对应" },
        "suggested_text": { "type": "string", "description": "建议补充/修改的文本" }
      }
    },
    "VersionScore": {
      "type": "object",
      "required": ["overall", "rules"],
      "properties": {
        "overall": { "type": "integer", "minimum": 0, "maximum": 100 },
        "rules": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
