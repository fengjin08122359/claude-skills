{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "test-case-structured.schema.json",
  "title": "结构化测试用例",
  "description": "test-generation skill 的中间表示，将手工测试用例转化为结构化的 GWT 描述",
  "type": "object",
  "required": ["id", "name", "given", "when", "then", "priority"],
  "properties": {
    "id": { "type": "string", "description": "用例ID，如 TC001" },
    "name": { "type": "string", "description": "用例名称" },
    "given": { "type": "string", "description": "前置条件（Given）" },
    "when": { "type": "string", "description": "操作步骤（When）" },
    "then": { "type": "string", "description": "预期结果（Then）" },
    "priority": { "type": "string", "enum": ["P0", "P1", "P2"] },
    "mappedRules": {
      "type": "array",
      "description": "映射到的 PRD 规则ID列表",
      "items": { "type": "string" }
    },
    "category": {
      "type": "string",
      "enum": ["normal", "boundary", "exception", "concurrency"],
      "description": "测试类别"
    },
    "source": {
      "type": "string",
      "description": "来源文件路径"
    }
  }
}
