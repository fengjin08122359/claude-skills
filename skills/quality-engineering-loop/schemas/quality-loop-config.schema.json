{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "quality-loop-config.schema.json",
  "title": "Quality Loop CI 配置",
  "description": ".quality-loop.json 配置文件的 schema，定义门禁规则、触发器、通知",
  "type": "object",
  "required": ["version", "gates", "triggers"],
  "properties": {
    "version": { "type": "string" },
    "description": { "type": "string" },
    "gates": { "$ref": "#/definitions/Gates" },
    "triggers": { "$ref": "#/definitions/Triggers" },
    "artifacts": { "$ref": "#/definitions/Artifacts" },
    "notifications": { "$ref": "#/definitions/Notifications" },
    "dev_standards_backfill": { "$ref": "#/definitions/BackfillConfig" }
  },
  "definitions": {
    "Gates": {
      "type": "object",
      "properties": {
        "coverage_rate": { "$ref": "#/definitions/Gate" },
        "test_alignment_rate": { "$ref": "#/definitions/Gate" },
        "code_gap_count": { "$ref": "#/definitions/Gate" },
        "mismatch_count": { "$ref": "#/definitions/Gate" }
      }
    },
    "Gate": {
      "type": "object",
      "required": ["threshold", "level", "message"],
      "properties": {
        "threshold": { "type": "number" },
        "level": { "type": "string", "enum": ["error", "warning", "info"] },
        "message": { "type": "string" }
      }
    },
    "Triggers": {
      "type": "object",
      "properties": {
        "prd_change": { "$ref": "#/definitions/Trigger" },
        "code_change": { "$ref": "#/definitions/Trigger" },
        "test_change": { "$ref": "#/definitions/Trigger" }
      }
    },
    "Trigger": {
      "type": "object",
      "required": ["paths", "actions", "gate"],
      "properties": {
        "paths": { "type": "array", "items": { "type": "string" } },
        "actions": { "type": "array", "items": { "type": "string" } },
        "gate": { "type": "boolean" },
        "description": { "type": "string" }
      }
    },
    "Artifacts": {
      "type": "object",
      "required": ["output_dir", "files"],
      "properties": {
        "output_dir": { "type": "string" },
        "files": { "type": "array", "items": { "type": "string" } },
        "retention_days": { "type": "integer", "minimum": 1 }
      }
    },
    "Notifications": {
      "type": "object",
      "properties": {
        "pr_comment": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "template": { "type": "string" },
            "include_matrix": { "type": "boolean" },
            "include_action_items": { "type": "boolean" }
          }
        },
        "slack": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "webhook_url": { "type": "string" },
            "on_gate_failure": { "type": "boolean" }
          }
        }
      }
    },
    "BackfillConfig": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "threshold_repeated_issues": { "type": "integer", "minimum": 1 },
        "output_path": { "type": "string" }
      }
    }
  }
}
