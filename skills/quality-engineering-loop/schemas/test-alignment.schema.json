{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "test-alignment.schema.json",
  "title": "测试用例-PRD 对齐报告",
  "description": "test-generation skill 的对齐比较输出，展示测试用例与 PRD 规则的映射关系",
  "type": "object",
  "required": ["report_id", "prd_file", "test_source", "mappings", "statistics"],
  "properties": {
    "report_id": { "type": "string" },
    "prd_file": { "type": "string" },
    "test_source": { "type": "string", "description": "测试用例来源（文件路径）" },
    "generated_at": { "type": "string", "format": "date-time" },
    "mappings": {
      "type": "array",
      "description": "PRD 规则与测试用例的映射",
      "items": { "$ref": "#/definitions/RuleMapping" }
    },
    "unmappedTests": {
      "type": "array",
      "description": "无对应 PRD 规则的冗余测试",
      "items": { "$ref": "#/definitions/UnmappedTest" }
    },
    "statistics": { "$ref": "#/definitions/Statistics" }
  },
  "definitions": {
    "RuleMapping": {
      "type": "object",
      "required": ["ruleId", "ruleDescription", "status"],
      "properties": {
        "ruleId": { "type": "string" },
        "ruleDescription": { "type": "string" },
        "testCases": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" }
            }
          }
        },
        "status": {
          "type": "string",
          "enum": ["COVERED", "GAP", "PARTIAL"]
        },
        "suggestedTestCase": {
          "type": "object",
          "description": "当 status=GAP 时的建议测试用例",
          "properties": {
            "name": { "type": "string" },
            "scenario": { "type": "string" }
          }
        }
      }
    },
    "UnmappedTest": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "suggestion": {
          "type": "string",
          "description": "可能是 PRD 遗漏，建议确认"
        }
      }
    },
    "Statistics": {
      "type": "object",
      "required": ["totalRules", "coveredRules", "gapRules", "totalTests", "mappedTests", "unmappedTests", "alignmentRate"],
      "properties": {
        "totalRules": { "type": "integer" },
        "coveredRules": { "type": "integer" },
        "gapRules": { "type": "integer" },
        "totalTests": { "type": "integer" },
        "mappedTests": { "type": "integer" },
        "unmappedTests": { "type": "integer" },
        "alignmentRate": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
