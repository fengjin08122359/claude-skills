{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "prd-analysis.schema.json",
  "title": "PRD 结构化分析输出",
  "description": "prd-structured-analysis skill 的输出，包含规则元组、状态迁移表、隐性规则",
  "type": "object",
  "required": ["rules"],
  "properties": {
    "rules": {
      "type": "array",
      "description": "从 PRD 提取的规则列表",
      "items": { "$ref": "#/definitions/Rule" }
    },
    "stateMachine": {
      "type": "object",
      "description": "状态机定义（如果 PRD 包含状态流转）",
      "required": ["name", "states", "transitions"],
      "properties": {
        "name": { "type": "string" },
        "states": { "type": "array", "items": { "type": "string" } },
        "transitions": {
          "type": "array",
          "items": { "$ref": "#/definitions/Transition" }
        },
        "timeTriggers": {
          "type": "array",
          "items": { "$ref": "#/definitions/TimeTrigger" }
        }
      }
    },
    "explicitRules": {
      "type": "array",
      "description": "显性查询规则",
      "items": { "$ref": "#/definitions/QueryRule" }
    },
    "implicitRules": {
      "type": "array",
      "description": "隐性规则（从显性描述推导）",
      "items": { "$ref": "#/definitions/ImplicitRule" }
    }
  },
  "definitions": {
    "Rule": {
      "type": "object",
      "required": ["id", "description", "type", "priority"],
      "properties": {
        "id": { "type": "string", "pattern": "^R\\d{3}$" },
        "description": { "type": "string" },
        "type": {
          "type": "string",
          "enum": ["calculation", "function_mapping", "boundary_constraint", "fallback", "condition", "constraint"]
        },
        "formula": { "type": "string" },
        "expression": { "type": "string" },
        "input": { "type": "string" },
        "output": { "type": "string" },
        "constraints": { "type": "array", "items": { "type": "string" } },
        "condition": { "type": "string" },
        "default": { "type": "string" },
        "enforcement": { "type": "string", "enum": ["mandatory", "recommended"] },
        "priority": { "type": "string", "enum": ["P0", "P1", "P2"] }
      }
    },
    "Transition": {
      "type": "object",
      "required": ["from", "to", "trigger", "legal"],
      "properties": {
        "from": { "type": "string" },
        "to": { "type": "string" },
        "trigger": { "type": "string" },
        "condition": { "type": "string" },
        "legal": { "type": "boolean" },
        "reason": { "type": "string" }
      }
    },
    "TimeTrigger": {
      "type": "object",
      "required": ["state", "duration", "action"],
      "properties": {
        "state": { "type": "string" },
        "duration": { "type": "string" },
        "action": { "type": "string" },
        "raceConditions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "QueryRule": {
      "type": "object",
      "required": ["id", "description", "index_required"],
      "properties": {
        "id": { "type": "string", "pattern": "^Q\\d{3}$" },
        "description": { "type": "string" },
        "sql": { "type": "string" },
        "index_required": { "type": "boolean" }
      }
    },
    "ImplicitRule": {
      "type": "object",
      "required": ["id", "description", "reason", "risk", "verification"],
      "properties": {
        "id": { "type": "string", "pattern": "^QI\\d{3}$" },
        "description": { "type": "string" },
        "reason": { "type": "string" },
        "risk": { "type": "string", "enum": ["HIGH", "MEDIUM", "LOW"] },
        "verification": { "type": "string" }
      }
    }
  }
}
